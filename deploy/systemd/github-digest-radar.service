[Unit]
Description=Builder Radar daily pipeline (ingest + rank + analyze + pair)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=github-digest
Group=github-digest
WorkingDirectory=/opt/github-digest
EnvironmentFile=/etc/github-digest.env

RuntimeDirectory=github-digest
RuntimeDirectoryMode=0750

ExecStart=/usr/bin/flock -n /run/github-digest/radar.lock \
    /opt/github-digest/.venv/bin/python3 /opt/github-digest/run_daily_pipeline.py

# analyze-worker is spawned as a detached subprocess by the pipeline script;
# this service exits quickly after queuing it.

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/github-digest /var/log/github-digest
