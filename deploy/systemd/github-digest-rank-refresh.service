[Unit]
Description=Builder Radar intra-day rank refresh (every 2 hours)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=github-digest
Group=github-digest
WorkingDirectory=/opt/github-digest
EnvironmentFile=/etc/github-digest.env

RuntimeDirectory=github-digest
RuntimeDirectoryMode=0750

ExecStart=/usr/bin/flock -n /run/github-digest/rank-refresh.lock \
    /opt/github-digest/.venv/bin/github-digest rank-refresh

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/github-digest /var/log/github-digest
